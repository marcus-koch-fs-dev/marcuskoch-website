---
// src/components/Footer/Footer.astro
import "./footer.scss";
---
<footer>
  <div class="wrapper">
    <section class="sm-wrapper">
      <ul class="sm-list">
        <li class="sm-item">
          <a href="https://www.linkedin.com/in/marcus-koch-dev" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <i class="sm-icon fa-brands fa-linkedin" aria-hidden="true" />
          </a>
        </li>
        <li class="sm-item">
          <a href="https://github.com/marcus-koch-fs-dev" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <i class="sm-icon fa-brands fa-github" aria-hidden="true" />
          </a>
        </li>
      </ul>
    </section>
    <section class="laws">
      <ul class="laws-list">
        <li class="laws-item">
          <span>Copyright ©{new Date().getFullYear()} Marcus Koch</span>
        </li>
        <li class="laws-item">
          <a href="/datenschutz" class="laws-p">Datenschutz</a>
        </li>
        <li class="laws-item">
          <a href="/impressum" class="laws-p">Impressum</a>
        </li>
      </ul>
    </section>
  </div>
</footer>

<script>
  // The globe hero is a single already-mounted React island (WebGL globe
  // + state). Navigating to /impressum or /datenschutz would unmount and
  // re-create it from scratch -- visible as a jarring re-render/"hitch".
  // Intercept the click and switch its internal destination instead,
  // syncing the URL via pushState so the links still work as direct/
  // bookmarkable routes when there's no globe hero on the page yet.
  const legalLinks = document.querySelectorAll(
    '.laws-item a[href="/impressum"], .laws-item a[href="/datenschutz"]'
  );
  legalLinks.forEach((link) => {
    link.addEventListener("click", (e) => {
      if (!document.querySelector(".globe-hero")) return;
      e.preventDefault();
      const href = link.getAttribute("href");
      const destination = href.slice(1);
      history.pushState({}, "", href);
      window.dispatchEvent(new CustomEvent("globe-hero:destination", { detail: destination }));
    });
  });
</script>
