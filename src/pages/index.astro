---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import GlobeHero from "../components/experiments/GlobeHero.jsx";
---
<BaseLayout>
  <link
    href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />
  </noscript>
  <main>
    <GlobeHero client:only="react" />
  </main>
</BaseLayout>

<style>
  /* Footer is normally in-flow (100vh hero + footer taller than the
     viewport forces a page scrollbar). Taken out of flow here so the
     hero stays exactly 100vh and the footer stays on screen as a thin
     overlay bar instead. Scoped to this page only. */
  :global(footer) {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 4;
  }

  :global(footer .wrapper) {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding: 0.5rem 1.5rem;
    background: rgba(2, 5, 4, 0.95);
    backdrop-filter: blur(6px);
    /* Same visual style as the hero's "> STATUS: NOMINAL" status log:
       mono, regular weight, small, dim phosphor green -- not the bold
       nav display font, which read too heavy here. */
    font-family: "Share Tech Mono", "Courier New", monospace;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  /* GitHub/LinkedIn already live in the hero's status log; no need to
     duplicate them in the footer bar too. */
  :global(footer .sm-wrapper) {
    display: none;
  }

  :global(footer .laws),
  :global(footer .laws-item span),
  :global(footer .laws a) {
    color: rgba(109, 255, 168, 0.75);
    font-weight: 400;
  }

  :global(footer .laws-list) {
    padding-bottom: 0;
    font-size: 0.8rem;
  }

  :global(footer .laws-item a) {
    cursor: pointer;
  }
</style>
