---
// Spike prototype — not linked from nav, not wired into the real Home.
// Evaluate the globe/theming/geolocation idea in isolation before deciding
// whether (and how) it belongs on the real site.
import BaseLayout from "../../layouts/BaseLayout.astro";
import GlobeHero from "../../components/experiments/GlobeHero.jsx";
---
<BaseLayout title="Globe Spike">
  <link
    href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />
  </noscript>
  <GlobeHero client:only="react" />
</BaseLayout>

<style>
  /* This page's own in-globe terminal replaces top nav on desktop.
     Scoped to this page only — the real site nav is untouched elsewhere. */
  @media screen and (min-width: 769px) {
    :global(.menu-horizontal) {
      display: none;
    }
    :global(.menu-wrapper-horizontal .themesToggler) {
      display: none;
    }
  }
</style>
